# Copy to .env and fill in.
COURTWATCH_DB=courtwatch.db
COURTWATCH_TZ=Asia/Kolkata
COURTWATCH_NOTIFY_DAYS_BEFORE=1
COURTWATCH_REQUEST_DELAY=2

# tesseract (automatic, needs `pip install .[ocr]` + tesseract-ocr) or manual
COURTWATCH_CAPTCHA_SOLVER=tesseract

# console (dry run), whatsapp_cloud, or twilio
COURTWATCH_NOTIFIER=console

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=hearing_reminder
WHATSAPP_TEMPLATE_LANG=en

# Twilio WhatsApp (alternative)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_CONTENT_SID=
